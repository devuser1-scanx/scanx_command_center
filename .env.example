APP_NAME=scanx-command-center-api
APP_ENV=local
DEBUG=true

# Local development example:
DATABASE_URL=postgresql+psycopg://scanx:scanx@localhost:5432/scanx_command_center

# Cloud Run + Cloud SQL alternative. DATABASE_PASSWORD should come from Secret Manager.
# DATABASE_HOST=/cloudsql/YOUR_PROJECT:YOUR_REGION:YOUR_INSTANCE
# DATABASE_NAME=scanx_app
# DATABASE_USER=postgres
# DATABASE_PASSWORD=
NEXT_PUBLIC_API_BASE_URL=https://prosthionic-pseudoscientific-camden.ngrok-free.dev

JWT_SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# WestFax (https://westfax.com) - REST API credentials for sending faxes.
# WESTFAX_PRODUCT_ID is a GUID obtained once via a GetProductList call against
# the account, not chosen manually.
WESTFAX_BASE_URL=https://api.westfax.com/Polka.Api/REST
WESTFAX_USERNAME=
WESTFAX_PASSWORD=
WESTFAX_PRODUCT_ID=
WESTFAX_FAX_HEADER=ScanX Command Center

# Gmail API + Workspace domain-wide delegation - used to send patient
# reports by email. GMAIL_SENDER_EMAIL is the mailbox the service account
# impersonates (must be a real mailbox on the Workspace domain).
# GMAIL_SERVICE_ACCOUNT_JSON is the full contents of a downloaded service
# account key, as a single-line JSON string. That service account's Client
# ID (its "Unique ID") must be authorized in Workspace Admin Console under
# Security > Access and data control > API controls > Domain-wide
# Delegation, with scope https://www.googleapis.com/auth/gmail.send.
GMAIL_SENDER_EMAIL=
GMAIL_SERVICE_ACCOUNT_JSON=