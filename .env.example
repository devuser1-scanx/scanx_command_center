APP_NAME=scanx-command-center-api
APP_ENV=local
DEBUG=true

# Local development example:
DATABASE_URL=postgresql+psycopg://scanx:scanx@localhost:5432/scanx_command_center

# Cloud Run + Cloud SQL alternative. DATABASE_PASSWORD should come from Secret Manager.
# DATABASE_HOST=/cloudsql/YOUR_PROJECT:YOUR_REGION:YOUR_INSTANCE
# DATABASE_NAME=scanx_app
# DATABASE_USER=postgres
# DATABASE_PASSWORD=
NEXT_PUBLIC_API_BASE_URL=https://prosthionic-pseudoscientific-camden.ngrok-free.dev

# Required - the app fails to start without this. Must be a strong random
# secret at least 32 characters long; there is no insecure fallback.
JWT_SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Automatic logoff (HIPAA 45 CFR 164.312(a)(2)(iii)). The browser signs a user out
# after this many minutes with no real input (mouse, keyboard, touch: not the
# page's background polling), warning them SESSION_WARNING_SECONDS before. A
# session also ends SESSION_MAX_HOURS after login, whatever the activity.
# Shorten the idle time for shared or public-area workstations. Defaults shown.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_WARNING_SECONDS=120
SESSION_MAX_HOURS=12
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Used to build the link sent in password-reset emails.
FRONTEND_BASE_URL=http://localhost:3000

# Base URL of the already-deployed scanx-pdf-proxy service, which generates
# and hosts the short, self-expiring report download links texted to
# patients. Only needs overriding if that service moves.
# PDF_PROXY_BASE_URL=https://scanx-pdf-proxy-794794356928.us-central1.run.app

# Login lockout: after this many consecutive failed attempts, the account
# is locked for AUTH_ACCOUNT_LOCK_MINUTES.
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=3
AUTH_ACCOUNT_LOCK_MINUTES=5

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Gmail API + Workspace domain-wide delegation - used to send patient
# reports by email, AND to send faxes via WestFax's email-to-fax gateway
# (an email to {digits}@westfax.com - see FAX_EMAIL_SUBJECT below).
# GMAIL_SENDER_EMAIL is the mailbox the service account impersonates (must
# be a real mailbox on the Workspace domain). GMAIL_SERVICE_ACCOUNT_JSON is
# the full contents of a downloaded service account key, as a single-line
# JSON string. That service account's Client ID (its "Unique ID") must be
# authorized in Workspace Admin Console under Security > Access and data
# control > API controls > Domain-wide Delegation, with scope
# https://www.googleapis.com/auth/gmail.send.
GMAIL_SENDER_EMAIL=
GMAIL_SERVICE_ACCOUNT_JSON=

# Fallback subject line for fax emails, used only if the patient's
# appointment can't be looked up (the normal subject is built from name +
# exam type).
FAX_EMAIL_SUBJECT=ScanX Command Center

# CC'd on every fax email as a receipt address - a single, easily-changed
# location rather than hardcoded in code.
FAX_FEEDBACK_EMAIL=scheduling@scanx.care

# Twilio - used to send text messages (SMS, and RCS if a Messaging Service
# with an RCS sender is configured; Twilio auto-falls-back to SMS when RCS
# isn't available, so no separate RCS flag is needed here).
# TWILIO_MESSAGING_SERVICE_SID is preferred over TWILIO_FROM_NUMBER - only
# a Messaging Service can have an RCS sender attached in the Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=+15555550123

# Acuity Scheduling API - used to fetch the live reschedule link for a
# patient's appointment (GET /api/v1/appointments/{appointment_id}). Uses
# HTTP Basic Auth: ACUITY_USER_ID as the username, ACUITY_API_KEY as the
# password. Both are found in Acuity under Business Settings > Integrations
# > API.
ACUITY_USER_ID=
ACUITY_API_KEY=
ACUITY_CHECKED_IN_LABEL_ID=
TWILIO_PAYMENT_TEMPLATE_SID=

GCHAT_WEBHOOK_DALLAS=
GCHAT_WEBHOOK_FAIRVIEW=
GCHAT_WEBHOOK_ARLINGTON=
GCHAT_WEBHOOK_FALLBACK=

# Google Chat card buttons. N8N_WEBHOOK_BASE_URL serves /allow-entry and
# /ask-to-wait.
N8N_WEBHOOK_BASE_URL=https://n8n-794794356928.us-central1.run.app/webhook
# Fax Portal: WestFax Comprehend webhook (POST /fax-portal/webhooks/comprehend).
# Fails closed: with no token set every delivery is rejected. Use long random
# values; in Cloud Run both come from Secret Manager. Send the token as an
# "Authorization: Bearer" or "X-Api-Key" header rather than ?token= when the
# connector allows it (query strings end up in request logs).
COMPREHEND_WEBHOOK_TOKEN=
# Optional: connector HMAC-SHA256 secret; when set, a valid signature header is also required.
COMPREHEND_WEBHOOK_HMAC_SECRET=
# Largest webhook body accepted, in bytes (default 10 MiB). Normally left alone.
# COMPREHEND_WEBHOOK_MAX_BODY_BYTES=10485760
# The Cloud Storage bucket WestFax writes the fax PDFs to (the default is shown;
# the service account the app runs as needs read access to it).
# COMPREHEND_GCS_BUCKET=westfax_comprehend_fax_pdfs

# Comprehend OCR webhook URI: https://scanx-command-center-staging-794794356928.us-central1.run.app/fax-portal/webhooks/comprehend

# Fax Portal, Twilio: the public https URL of this API (the deployed Cloud Run
# service, or an ngrok URL locally), no trailing slash. Twilio calls it back for
# text delivery status and for click-to-call instructions, and the calls are
# verified against it, so it must be exactly what Twilio can reach.
# Example: https://scanx-command-center-staging-794794356928.us-central1.run.app
PUBLIC_API_BASE_URL=

# Fax Portal click-to-call, from the browser (Twilio Voice SDK): the staff member
# talks through their computer and Twilio dials the patient. No staff phone is
# involved.
# TWILIO_VOICE_FROM_NUMBER: the organisation's voice-capable Twilio number (an RCS
# sender cannot place calls). Every call is placed from it: it is the caller ID
# the patient sees.
TWILIO_VOICE_FROM_NUMBER=
# Twilio Console > Account > API keys & tokens > Create API key (Standard). Signs
# the short-lived token the browser connects with. The secret is shown once.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Twilio Console > Voice > Manage > TwiML Apps > Create. Set its Voice Request URL
# (HTTP POST) to <PUBLIC_API_BASE_URL>/fax-portal/webhooks/twilio/voice/client and
# its Status Callback URL (HTTP POST) to
# <PUBLIC_API_BASE_URL>/fax-portal/webhooks/twilio/voice/status. Put its SID here.
TWILIO_TWIML_APP_SID=
# Also needs TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and PUBLIC_API_BASE_URL above.

# Calls module (the Web Dialer). Browser calls go through the standalone Web
# Dialer's own TwiML App, so that service answers Twilio and dials, records, logs
# the call in the production call_logs / dialer_call_* tables and sends the
# missed-call alerts, exactly as for its own frontend. Command Center only issues
# the browser token (to people with calls.create), keeps its own record of who
# placed each call (cc_call_logs) with audit entries, and reads the shared tables.
# DIALER_TWIML_APP_SID: the standalone Web Dialer's TwiML App SID (its
# TWILIO_TWIML_APP_SID), kept apart from the Fax Portal's TWILIO_TWIML_APP_SID
# above. Also needs TWILIO_ACCOUNT_SID, TWILIO_API_KEY_SID and TWILIO_API_KEY_SECRET
# above, from the same Twilio account as that app. Unset: Calls answers 503.
DIALER_TWIML_APP_SID=

# Messages module (the Patient Inbox). Conversations are kept in Firestore, shared
# with the standalone Inbox service, which also receives the patients' replies
# (its Twilio webhook, Google Chat alert and n8n forwarding stay there). Command
# Center reads and writes the same conversations, keeps its own audit entries, and
# sends through the Twilio settings above (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN,
# TWILIO_MESSAGING_SERVICE_SID); TWILIO_VOICE_FROM_NUMBER is stored as the
# business number of each conversation. Needs Firestore access for the Cloud Run
# service account (role Cloud Datastore User) in the project that holds the
# conversations.
# Content Template SIDs of the exam RCS card (the standalone Inbox's variables).
# TWILIO_RCS_CARD_CONTENT_SID is the default; an exam with its own template uses
# TWILIO_RCS_CARD_CONTENT_SID_<EXAM> instead (FIBROSCAN, THYROID, ABDOMINAL,
# TRANSVAGINAL). An exam with neither answers 503.
TWILIO_RCS_CARD_CONTENT_SID=
# TWILIO_RCS_CARD_CONTENT_SID_FIBROSCAN=
# TWILIO_RCS_CARD_CONTENT_SID_THYROID=
# TWILIO_RCS_CARD_CONTENT_SID_ABDOMINAL=
# TWILIO_RCS_CARD_CONTENT_SID_TRANSVAGINAL=
